{% extends 'base.html.twig' %}

{% block body %}
  {{~ Indentation }}<body class="vh-100 d-flex">
  {{~ Indentation }}  <div class="m-auto border rounded carte">
  {%~ for Clef, Nom in Application.getFichiers() %}
      {%~ if not loop.first %}
        {{~ Indentation }}    <div class="mx-auto p-2 col-11 border border-start-0 border-top-0 border-end-0 d-flex">
        {{~ Indentation }}      <div class="ms-2 my-auto col-9">{{ Nom }}</div>
        {{~ Indentation }}      <a href="{{ path('FichierCSV', {'clef': Clef}) }}" class="btn btn-primary" title="{{ 'Administration.Bouton.Telecharger'|trans({}, 'messages') }} : {{ Nom }}">
        {{~ Indentation }}        <i class="fa-solid fa-floppy-disk fa-fw"></i>
        {{~ Indentation }}      </a>
        {{~ Indentation }}    </div>
      {%~ else %}
        {{~ Indentation }}    <div class="mx-auto p-2 col-11 border border-start-0 border-top-0 border-end-0 d-flex">
        {{~ Indentation }}      <div class="mx-auto">
        {{~ Indentation }}        <a href="{{ path('Administration') }}" class="btn btn-primary" title="{{ 'Administration.Bouton.Revenir'|trans({}, 'messages') }}">
        {{~ Indentation }}          <i class="fa-solid fa-circle-left"></i>
        {{~ Indentation }}        </a>
        {{~ Indentation }}      </div>
        {{~ Indentation }}    </div>
      {%~ endif %}
  {%~ endfor %}
  {{~ Indentation }}  </div>
  {{~ Indentation }}</body>
{% endblock %}