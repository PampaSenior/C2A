{%~ if Parametres.getTaille() == 'sm' -%}
  {%~ set TexteGagnant = 'Resultat.Gagnant.sm'|trans({}, 'messages') %}
  {%~ set TexteCadeau = 'Resultat.Cadeau.sm'|trans({}, 'messages') %}
{%~ elseif Parametres.getTaille() == 'md' -%}
  {%~ set TexteGagnant = 'Resultat.Gagnant.md'|trans({}, 'messages') %}
  {%~ set TexteCadeau = 'Resultat.Cadeau.md'|trans({}, 'messages') %}
{%~ elseif Parametres.getTaille() == 'lg' -%}
  {%~ set TexteGagnant = 'Resultat.Gagnant.lg'|trans({}, 'messages') %}
  {%~ set TexteCadeau = 'Resultat.Cadeau.lg'|trans({}, 'messages') %}
{%~ else -%}
  {%~ set TexteGagnant = 'Resultat.Gagnant.xl'|trans({}, 'messages') %}
  {%~ set TexteCadeau = 'Resultat.Cadeau.xl'|trans({}, 'messages') %}
{%~ endif -%}

{% set Loupe = 'Resultat.Loupe'|trans({},'messages') -%}

{{ Indentation }}<div id="{{ Jour }}" class="m-2 text-success bloc {{ Parametres.getBordure() }} {{ Parametres.getTaille() }} position-relative" title="{{ TexteGagnant }}{{ Resultat['gagnant'] }}&#10;{{ TexteCadeau }}{{ Resultat['cadeau'] }}" data-taille="{{ Parametres.getTaille() }}" {%~ if Resultat['illustration'] != '' %} style="background-image: url('{{ Resultat['illustration'] }}');background-size: cover"{% endif ~%}>
{{ Indentation }}  <div class="d-block text-truncate">
{%~ if TexteGagnant != '' %}
  {{~ Indentation }}    <p class="mb-0 text-danger contour">{{ TexteGagnant }}</p>
{%~ endif %}
{{ Indentation }}    <p class="mb-0 text-success contour">{{ Resultat['gagnant'] }}</p>
{%~ if TexteCadeau != '' %}
  {{~ Indentation }}    <p class="mb-0 text-danger contour">{{ TexteCadeau }}</p>
{%~ endif %}
{{ Indentation }}    <p class="mb-0 text-success contour">{{ Resultat['cadeau'] }}</p>
{{ Indentation }}  </div>
{%~ if Parametres.getZoom() != '' %}
  {{~ Indentation }}  <div>
  {{~ Indentation }}    <button type="button" class="py-2 {{ Parametres.getZoom() }} translate-middle badge bg-danger border-0" data-gagnant="{{ Resultat['gagnant'] }}" data-cadeau="{{ Resultat['cadeau'] }}" {%~ if Resultat['illustration'] != '' %} data-photo="{{ Resultat['illustration'] }}" {% else %} {% endif ~%} onclick="ClicLoupe()" aria-label="{{ Loupe }}" title="{{ Loupe }}">
  {{~ Indentation }}      <i class="fa-solid fa-magnifying-glass fa-fw"></i>
  {{~ Indentation }}    </button>
  {{~ Indentation }}  </div>
{%~ endif %}
{{ Indentation }}</div>