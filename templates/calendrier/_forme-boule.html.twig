{%~ if Parametres.getNb() == 24 %}
  {% set Max = [2, 4, 6, 6, 4, 2] %}
  {% set JourEtoile = [9, 10, 15, 16] -%}
{%~ else %}
  {% set Max = [1, 3, 5, 7, 5, 3, 1] %}
  {% set JourEtoile = [13] -%}
{%~ endif %}

{% set Compteur = 0 -%}

{% for i in 0..Max|length - 1 %}
  {{~ Indentation }}<div class="mx-auto d-flex justify-content-center">
  {%~ for j in 0..Max[i] - 1 %}
    {%~ set Compteur = Compteur + 1 %}
    {%~
      include 'calendrier/_jour.html.twig'
      with {
        'Indentation' : Indentation ~ '  ',
        'Style' : Style,
        'JourEtoile' : JourEtoile,
        'Jour' : Compteur
      }
    ~%}
  {%~ endfor %}
  {{~ Indentation }}</div>
{% endfor %}