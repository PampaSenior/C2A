{% set Fermer = 'Modale.Fermer'|trans({},'messages') -%}
{% set Titre = 'Modale.Zoom.Titre'|trans({},'messages') -%}
{% set Gagnant = 'Modale.Zoom.Gagnant'|trans({},'messages') -%}
{% set Cadeau = 'Modale.Zoom.Cadeau'|trans({},'messages') -%}

{{ Indentation }}<div id="ZoomResultat" class="text-center modal" tabindex="-1">
{{ Indentation }}  <div class="modal-dialog modal-dialog-centered">
{{ Indentation }}    <div class="modal-content border border-success border-2">
{{ Indentation }}      <div class="modal-header border-success border-2 z-index-1">
{{ Indentation }}        <h2 class="m-0 modal-title text-danger fw-bold">
{{ Indentation }}          {{ Titre }}<span id="jour"></span>
{{ Indentation }}        </h2>
{{ Indentation }}        <button type="button" class="btn border border-success border-2" onclick="$('#ZoomResultat').hide();" aria-label="{{ Fermer }}" title="{{ Fermer }}">
{{ Indentation }}          <i class="fas fa-times fa-2x"></i>
{{ Indentation }}        </button>
{{ Indentation }}      </div>
{{ Indentation }}      <div class="modal-body">
{{ Indentation }}        <p class="mb-0 h5 text-success fw-bold">{{ Gagnant }}</p>
{{ Indentation }}        <p id="gagnant" class="mb-0 text-success fw-bold contour"></p>
{{ Indentation }}        <p class="mb-0 h5 text-success fw-bold">{{ Cadeau }}</p>
{{ Indentation }}        <p id="cadeau" class="mb-0 text-success fw-bold contour"></p>
{{ Indentation }}        <img id="photo" class="img-fluid d-none" src=""/>
{{ Indentation }}      </div>
{{ Indentation }}      <div class="modal-footer border-success border-2 text-center z-index-1">
{{ Indentation }}        <div class="mx-auto d-flex align-items-center">
{{ Indentation }}          <i class="fas fa-hand-holding-heart fa-flip-horizontal fa-2x text-info"></i>
{{ Indentation }}          <i class="mx-2 fas fa-beat fa-gift fa-2x text-danger"></i>
{{ Indentation }}          <i class="fas fa-hand-holding-heart fa-2x text-info"></i>
{{ Indentation }}        </div>
{{ Indentation }}      </div>
{{ Indentation }}    </div>
{{ Indentation }}  </div>
{{ Indentation }}</div>